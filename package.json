{
  "name": "markdown-previewer",
  "private": true,
  "version": "0.1.0",
  "description": "Free online Markdown previewer with live GitHub Flavored Markdown preview. Runs entirely in the browser.",
  "author": "Imran Pollob",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
